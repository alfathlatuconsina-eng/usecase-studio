# ============================================================
#  .gitignore — UseCase Studio dashboards
#
#  Daftar berkas yang TIDAK boleh ikut tersimpan ke git.
#  (List of files git must never save.)
#
#  Alasan utama: berkas .env berisi kata sandi database dan
#  kunci JWT. Berkas .sql berisi salinan isi database.
#  Keduanya pernah ikut terkirim ke GitHub publik.
# ============================================================

# --- Rahasia. Jangan pernah dihapus dari daftar ini. ---
.env
.env.*
!.env.example
backend/.env

# --- Salinan database (cadangan / tarikan dari VPS) ---
# Ukurannya ratusan MB dan isinya data internal.
*.sql
!backend/branchops/schema.sql
!migrations/*.sql
# Skrip migrasi manual - kode, bukan salinan data. Wajib ikut tersimpan.
!hapus-kolom-region-lama.sql

# Skrip di deploy/ juga kode, bukan salinan data - wajib ikut tersimpan.
# Aman: pola tanpa tanda bintang bersarang TIDAK menembus subfolder, jadi
# baris ini tidak bisa membocorkan deploy/masuk/ atau deploy/keluaran/.
!deploy/*.sql

# Salinan data yang ditarik dari / didorong ke VPS. Isinya nama nasabah
# asli - penyamaran "***" terjadi di API, bukan di basis data.
# Diabaikan per-folder, bukan hanya lewat *.sql di atas, supaya berkas
# .csv atau .dump di dalamnya juga tidak pernah ikut ter-commit.
deploy/masuk/
deploy/keluaran/
deploy/cadangan/

# --- Arsip berkas yang ditarik dari VPS ---
vps-berkas-*.tar.gz
*.tar.gz

# --- Berkas sementara Python ---
__pycache__/
*.py[cod]
*.pyo

# --- Lingkungan virtual Python ---
venv/
.venv/
env/

# --- Cadangan bertanggal yang dibuat manual ---
*.bak
*.bak-*
*.orig
xxx*

# --- Berkas yang diunggah pengguna lewat modul E-Library ---
uploads/elibrary/*
!uploads/elibrary/.gitkeep

# --- Berkas sistem ---
Thumbs.db
desktop.ini
.DS_Store
